{
  "name": "prism-plugin-qoder",
  "version": "0.1.3",
  "private": true,
  "description": "Prism Hub adapter for Qoder Agent SDK and Qoder IDE",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "src/",
    "pluginbridge-plugin.yaml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "probe": "node scripts/probe.mjs",
    "verify-release": "node scripts/verify-release.mjs",
    "build:ide": "npm --prefix ide-bridge run build",
    "package:ide": "npm --prefix ide-bridge run package",
    "stage-release": "node scripts/stage-release.mjs",
    "archive-release": "node scripts/archive-release.mjs",
    "create-release-metadata": "node scripts/create-release-metadata.mjs"
  },
  "dependencies": {
    "@qoder-ai/qoder-agent-sdk": "1.0.56",
    "@rokid-prism/pluginbridge-plugin-sdk": "^0.1.1"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "license": "MIT"
}
